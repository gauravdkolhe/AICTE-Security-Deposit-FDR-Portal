# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/aicte_fdr

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional - for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# SMTP (optional - for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@aicte-fdr.gov.in

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# App
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173

# Admin seed credentials (development only)
SEED_ADMIN_EMAIL=admin@aicte.gov.in
SEED_ADMIN_PASSWORD=Admin@12345
